{
  "name": "EnchufaTE · HaCAithon 2026",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Aplicación",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": {
    "app": "python3 backend/run.py"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt"
}
